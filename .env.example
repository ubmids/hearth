# Public URL of this server once tunnelled. Must match the `resource` the client sends.
HEARTH_ISSUER=https://your-tunnel.trycloudflare.com
HEARTH_RESOURCE=https://your-tunnel.trycloudflare.com/mcp
HEARTH_CLIENT_ID=hearth-dev-client

# Optional but strongly recommended once this is public: the exact redirect URIs
# allowed at /authorize, comma separated. Unset, any https (or loopback) URI is
# accepted, which makes the authorization endpoint an open redirector carrying
# an authorization code. The console's own URI is <issuer>/console.
HEARTH_REDIRECT_URIS=

# Optional. Any OpenAI-compatible endpoint for the extraction write path.
# Unset, Hearth uses the deterministic rule extractor and still runs end to end.
HEARTH_LLM_BASE_URL=
HEARTH_LLM_API_KEY=
HEARTH_LLM_MODEL=gpt-4o-mini

# Which household a new account starts in: care (default, the demo) or family.
HEARTH_HOUSEHOLD=care
# The household's time zone, for "this morning" and "Thursday at 10".
HEARTH_TZ=America/New_York

# --- the simulated Alexa+ client at /alexa (all optional) -------------------
# Add <issuer>/alexa to HEARTH_REDIRECT_URIS if the allowlist is set.
# Planner: any OpenAI-compatible endpoint with tool calling. Unset, the
# simulator uses its built-in rules, and says so on screen.
HEARTH_SIM_LLM_BASE_URL=
HEARTH_SIM_LLM_API_KEY=
HEARTH_SIM_LLM_MODEL=
# Voice: Amazon Polly neural if AWS keys are present (HEARTH_TTS=polly|piper|browser
# to force one). Piper is offline and free: download a voice from
# https://huggingface.co/rhasspy/piper-voices and point at the .onnx file.
HEARTH_TTS=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
HEARTH_PIPER_VOICE=
